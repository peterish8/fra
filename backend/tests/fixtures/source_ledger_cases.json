    },
    {
      "id": "default_http_port_is_removed",
      "input_url": "http://example.com:80/reports/annual",
      "expected_canonical_url": "http://example.com/reports/annual",
      "expected_identity_key": "url:http://example.com/reports/annual"
    },
    {
      "id": "document_identifier_is_preserved",
